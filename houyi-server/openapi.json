{
  "openapi": "3.1.0",
  "info": {
    "title": "HouyiDB HTTP API",
    "version": "0.2.0-beta",
    "description": "HouyiDB 向量数据库的 collections HTTP API。\n\n契约要点：\n- collection 在首次 upsert 时隐式创建，维度由首个向量定型；\n- 向量 id 为 u64 正整数键空间 [0, 2^63-1]；跨语言 SDK 的 `stable_id`（BLAKE2b-8 大端 & 2^63-1）可把任意字符串确定性映射进该空间，删除可跨 SDK 重放；\n- payload 键 `label` 为保留列，占用返回 400（请用顶层 `label` 字段）；\n- 检索响应的 `score` 是相似度（hnsw/flat/hii-l0 后端为 `1 - cosine_distance`，越大越相似）；\n- 双速写入：upsert 同步落标量页与 WAL，异步构图；检索对尚在队列中的向量不可见，`status.pending_count == 0` 后可见。\n- 错误响应为非 2xx + 纯文本诊断正文（text/plain）。",
    "license": { "name": "Apache-2.0" }
  },
  "servers": [{ "url": "http://127.0.0.1:7000" }],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "服务健康检查",
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "服务可用",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "enum": ["ok"] } },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "summary": "就绪探针（与 /v1/health 存活探针分离）：索引可响应且待构图队列低于反压水位线",
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "就绪",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadyzResponse" }
              }
            }
          },
          "503": {
            "description": "未就绪（待构图队列超水位线，摘流排空）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadyzResponse" }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "prometheusMetrics",
        "summary": "Prometheus 文本暴露端点（text/plain; version=0.0.4，8 个核心指标：hot_buffer / indexed_vectors / pending_build / flush_total / flushed_items_total / wal_active_bytes / pgwire_handshakes_total / pgwire_queries_total）",
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "Prometheus text exposition format",
            "content": { "text/plain": { "schema": { "type": "string" } } }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "openapiSpec",
        "summary": "本 OpenAPI 文档（内嵌于二进制，与版本同源）",
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 文档",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/v1/collections": {
      "get": {
        "operationId": "listCollections",
        "summary": "列出全部 collection",
        "tags": ["collections"],
        "responses": {
          "200": {
            "description": "collection 摘要数组",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CollectionInfo" }
                }
              }
            }
          }
        }
      }
    },
    "/v1/collections/{name}/upsert": {
      "post": {
        "operationId": "upsert",
        "summary": "写入一批向量（collection 首次写入时隐式创建）",
        "tags": ["collections"],
        "parameters": [{ "$ref": "#/components/parameters/CollectionName" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpsertRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "插入条数",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpsertResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/v1/collections/{name}/search": {
      "post": {
        "operationId": "search",
        "summary": "纯向量 top-k 检索",
        "tags": ["collections"],
        "parameters": [{ "$ref": "#/components/parameters/CollectionName" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SearchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "按相似度从高到低排列的命中",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/collections/{name}/hybrid/search": {
      "post": {
        "operationId": "hybridSearch",
        "summary": "向量 × 标量过滤的混合检索（filters 取交集，仅 hnsw/flat 后端）",
        "tags": ["collections"],
        "parameters": [{ "$ref": "#/components/parameters/CollectionName" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HybridSearchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "按相似度从高到低排列的命中",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/collections/{name}/delete": {
      "post": {
        "operationId": "delete",
        "summary": "按 id 和/或过滤条件删除（幂等；两者取并集）",
        "description": "按条件删除在标量页上同步求值，能命中刚写入、尚在异步构图队列中的向量——「先检索拿 id 再删」做不到这一点。",
        "tags": ["collections"],
        "parameters": [{ "$ref": "#/components/parameters/CollectionName" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeleteRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "真实删除数（不存在的 id 静默跳过）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeleteResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/collections/{name}/status": {
      "get": {
        "operationId": "collectionStatus",
        "summary": "collection 状态",
        "tags": ["collections"],
        "parameters": [{ "$ref": "#/components/parameters/CollectionName" }],
        "responses": {
          "200": {
            "description": "状态快照",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CollectionStatus" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/index/status": {
      "get": {
        "operationId": "indexStatus",
        "summary": "主索引双速写入指标（hot/pending/flush_count 等，可观测性用）",
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "指标快照（字段随版本演进，按宽松 object 消费）",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "/v1/wal/status": {
      "get": {
        "operationId": "walStatus",
        "summary": "WAL 状态",
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "WAL 状态快照",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "operationId": "embeddings",
        "summary": "OpenAI 兼容 embeddings 网关（代理上游 + 自动入库）",
        "description": "请求/响应形状与 OpenAI `/v1/embeddings` 一致（把 base URL 从 OpenAI 换成 HouyiDB 即可）。需以 ENV `HOUYI_OPENAI_UPSTREAM`（上游 base URL）与 `HOUYI_OPENAI_API_KEY` 配置上游；未配置返回 501。文本经 BLAKE2b-8 stable_id 定型为向量 id 后自动 upsert 进对应 collection，删除可跨 SDK 重放。",
        "tags": ["gateway"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EmbeddingsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OpenAI embeddings 响应（原样透传上游）",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EmbeddingsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "501": { "$ref": "#/components/responses/NotImplemented" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CollectionName": {
        "name": "name",
        "in": "path",
        "required": true,
        "description": "collection 名（URL 路径段须按 RFC 3986 转义）",
        "schema": { "type": "string" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求非法（维度不符 / k 越界 / op 白名单外 / 字面值形状错误 / 保留列占用等），正文为纯文本诊断",
        "content": { "text/plain": { "schema": { "type": "string" } } }
      },
      "NotFound": {
        "description": "collection 不存在，正文为纯文本诊断",
        "content": { "text/plain": { "schema": { "type": "string" } } }
      },
      "NotImplemented": {
        "description": "OpenAI 网关未配置上游（HOUYI_OPENAI_UPSTREAM 未设置）",
        "content": { "text/plain": { "schema": { "type": "string" } } }
      }
    },
    "schemas": {
      "ReadyzResponse": {
        "type": "object",
        "description": "就绪探针响应：200 时 status=ready，503 时 status=not_ready（字段同形，摘流期间仍可观测积压归因）",
        "properties": {
          "status": { "type": "string", "enum": ["ready", "not_ready"] },
          "pending_build": { "type": "integer" },
          "hot_buffer": { "type": "integer" },
          "indexed": { "type": "integer" },
          "watermark": { "type": "integer" }
        },
        "required": ["status", "pending_build", "hot_buffer", "indexed", "watermark"]
      },
      "CollectionInfo": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "dims": { "type": "integer" },
          "index_type": { "type": "string", "example": "hnsw" },
          "vectors": { "type": "integer" }
        },
        "required": ["name", "dims", "index_type", "vectors"]
      },
      "CollectionStatus": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "indexed_count": { "type": "integer", "description": "已入图向量数" },
          "pending_count": { "type": "integer", "description": "异步构图队列中待处理数；归零后检索可见" },
          "dims": { "type": "integer" },
          "index_type": { "type": "string" },
          "scalar_row_count": { "type": "integer", "description": "标量页行数（仅携带 label/payload 的向量建行）" }
        },
        "required": ["name", "indexed_count", "pending_count", "dims", "index_type", "scalar_row_count"]
      },
      "UpsertRequest": {
        "type": "object",
        "properties": {
          "vectors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UpsertVector" },
            "minItems": 1
          },
          "index": {
            "type": "object",
            "description": "可选 HNSW 构图提示",
            "properties": {
              "m": { "type": "integer" },
              "ef_construction": { "type": "integer" }
            }
          }
        },
        "required": ["vectors"]
      },
      "UpsertVector": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "description": "u64 正整数键空间；字符串 id 请用 stable_id 映射"
          },
          "values": {
            "type": "array",
            "items": { "type": "number", "format": "float" },
            "description": "向量分量；长度即 collection 维度（首个向量定型）"
          },
          "label": { "type": "string", "description": "可选标签（等价于 payload 的保留列 label）" },
          "payload": {
            "type": "object",
            "additionalProperties": true,
            "description": "自由 JSON 标量字段，供混合检索过滤；键 label 保留，占用 400"
          }
        },
        "required": ["id", "values"]
      },
      "UpsertResponse": {
        "type": "object",
        "properties": { "inserted": { "type": "integer" } },
        "required": ["inserted"]
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "vector": { "type": "array", "items": { "type": "number", "format": "float" } },
          "k": { "type": "integer", "minimum": 1 },
          "ef_search": { "type": "integer", "description": "可选 HNSW ef 覆盖（flat 后端忽略）" },
          "include_payload": { "type": "boolean", "default": false },
          "filter_gt_id": { "type": "integer", "format": "uint64", "description": "可选：仅返回 id 大于该值的命中" },
          "filter_label": { "type": "string", "description": "可选：按顶层 label 过滤" }
        },
        "required": ["vector", "k"]
      },
      "HybridSearchRequest": {
        "type": "object",
        "properties": {
          "vector": { "type": "array", "items": { "type": "number", "format": "float" } },
          "k": { "type": "integer", "minimum": 1 },
          "filters": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Filter" },
            "description": "多条取交集（AND）"
          },
          "include_payload": { "type": "boolean", "default": false },
          "ef_search": { "type": "integer" }
        },
        "required": ["vector", "k"]
      },
      "Filter": {
        "type": "object",
        "properties": {
          "column": { "type": "string", "description": "payload 键名，或保留列 label" },
          "op": { "type": "string", "enum": ["eq", "gt", "gte", "lt", "lte", "in"] },
          "value": {
            "description": "比较字面值：in 必须是布尔/数字/字符串数组；其余算子不得为数组/对象/null"
          }
        },
        "required": ["column", "op", "value"]
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": { "type": "integer", "format": "uint64" },
            "description": "与 scores 按下标对齐，按相似度从高到低"
          },
          "scores": {
            "type": "array",
            "items": { "type": "number", "format": "float" },
            "description": "相似度（越大越相似）；余弦后端为 1 - cosine_distance ∈ [-1,1]"
          },
          "payloads": {
            "type": "object",
            "additionalProperties": { "type": "object", "additionalProperties": true },
            "description": "键为 id 的十进制字符串；仅 include_payload=true 时存在"
          }
        },
        "required": ["ids", "scores"]
      },
      "DeleteRequest": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": { "type": "integer", "format": "uint64" },
            "description": "显式 id 列表；与 filters 命中取并集"
          },
          "filters": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Filter" }
          }
        }
      },
      "DeleteResponse": {
        "type": "object",
        "properties": { "deleted": { "type": "integer" } },
        "required": ["deleted"]
      },
      "EmbeddingsRequest": {
        "type": "object",
        "description": "OpenAI embeddings 请求子集（原样转发上游）",
        "properties": {
          "model": { "type": "string" },
          "input": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "encoding_format": { "type": "string", "enum": ["float", "base64"] }
        },
        "required": ["model", "input"]
      },
      "EmbeddingsResponse": {
        "type": "object",
        "description": "OpenAI embeddings 响应（原样透传）",
        "properties": {
          "object": { "type": "string" },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object": { "type": "string" },
                "index": { "type": "integer" },
                "embedding": { "type": "array", "items": { "type": "number" } }
              }
            }
          },
          "model": { "type": "string" },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" }
            }
          }
        }
      }
    }
  },
  "tags": [
    { "name": "collections", "description": "named collection 的写入/检索/删除/状态" },
    { "name": "gateway", "description": "OpenAI 兼容网关" },
    { "name": "meta", "description": "健康检查与内部状态" }
  ]
}
