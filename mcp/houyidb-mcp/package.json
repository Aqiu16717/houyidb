{
  "name": "houyidb-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for HouyiDB vector search",
  "mcpName": "io.github.houyidb-community/houyidb-mcp",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/houyidb-community/houyidb"
  },
  "homepage": "https://houyidb.top",
  "type": "module",
  "bin": {
    "houyidb-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "houyidb",
    "vector-database",
    "vector-search"
  ]
}
